import os
from pathlib import Path
import shutil


# MTerrain options are consumed before godot-cpp parses ARGUMENTS so the nested
# build does not report them as unknown variables.
mterrain_profile = ARGUMENTS.pop("mterrain_profile", "full")
mterrain_output_dir = ARGUMENTS.pop("mterrain_output_dir", "")

valid_profiles = ("full", "runtime", "web_core", "web_extended")
if mterrain_profile not in valid_profiles:
    raise ValueError(
        "mterrain_profile must be one of: " + ", ".join(valid_profiles)
    )

# Generated wrappers contain target-width-sensitive opaque sizes. Give each
# requested tuple its own godot-cpp variant tree so wasm32 and 64-bit builds can
# neither overwrite nor race one another's generated headers and libraries.
requested_binding_tuple = "-".join(
    str(ARGUMENTS.get(key, default)).replace("/", "_")
    for key, default in (
        ("platform", "default"),
        ("target", "template_debug"),
        ("arch", "default"),
        ("precision", "single"),
        ("threads", "default"),
    )
)
# Both Web profiles intentionally expose the same native MTerrain closure; the
# optional extended features live in the separately packaged runtime companion.
# Reuse the exact generated binding tuple instead of compiling an identical
# godot-cpp archive twice. A source-contract test requires the two JSON profiles
# to remain byte-for-byte equivalent while this sharing is enabled.
binding_profile_key = (
    "web_core"
    if mterrain_profile in ("web_core", "web_extended")
    else mterrain_profile
)
binding_variant_dir = Path(Dir(".").abspath).parent.joinpath(
    "build", "godot-cpp", requested_binding_tuple, binding_profile_key
)
binding_env = SConscript(
    "godot-cpp/SConstruct",
    variant_dir=str(binding_variant_dir),
    # godot-cpp mixes generated files with a few hand-authored headers/sources;
    # duplicating those inputs gives SCons a complete, independently scannable
    # variant tree instead of unresolved source nodes on clean full builds.
    duplicate=1,
)
# Profile-specific preprocessor definitions belong only to MTerrain objects.
# Mutating the environment returned by godot-cpp would retroactively change
# its command signatures, forcing an identical binding archive to rebuild when
# switching between web_core and web_extended.
env = binding_env.Clone()

if env["platform"] == "web" and mterrain_profile not in ("web_core", "web_extended"):
    raise ValueError(
        "Web builds support only mterrain_profile=web_core or web_extended"
    )
if mterrain_profile in ("web_core", "web_extended") and env["threads"]:
    raise ValueError("Web runtime profiles require threads=no")
if mterrain_profile in ("web_core", "web_extended") and env["precision"] != "single":
    raise ValueError("Web runtime profiles currently require precision=single")

source_dir = Path(Dir(".").abspath)
if mterrain_output_dir:
    output_dir = Path(mterrain_output_dir).expanduser()
    if not output_dir.is_absolute():
        output_dir = source_dir.joinpath(output_dir)
else:
    plugin_root = source_dir.parent
    if plugin_root.name == "m_terrain" and plugin_root.parent.name == "addons":
        # Preserve the established embedded-addon layout: the manifest expects
        # res://mterrain while sources live under res://addons/m_terrain.
        output_dir = plugin_root.parent.parent.joinpath("mterrain")
    else:
        output_dir = plugin_root.joinpath("build", "mterrain")
output_dir = output_dir.resolve()
os.makedirs(output_dir, mode=0o755, exist_ok=True)

env.Append(CPPPATH="src/")
if env["precision"] == "single":
    shutil.copy("MTerrain.txt", output_dir.joinpath("MTerrain.gdextension"))
elif env["precision"] == "double":
    shutil.copy("MTerrain_double.txt", output_dir.joinpath("MTerrain.gdextension"))
else:
    raise ValueError("Unsupported precision: " + str(env["precision"]))

src = list(Glob("src/*.cpp"))
src.extend(Glob("src/util/*.cpp"))
src.extend(Glob("src/height_brushes/*.cpp"))
src.extend(Glob("src/color_brushes/*.cpp"))

if mterrain_profile in ("web_core", "web_extended"):
    src = [
        node for node in src
        if node.name not in ("moctree.cpp", "mtool.cpp")
    ]
    env.Append(
        CPPDEFINES=[
            "MTERRAIN_CORE_ONLY",
            "MTERRAIN_MEMORY_ONLY_DEFAULT",
            "MTERRAIN_BOUNDED_RUNTIME",
            "MTERRAIN_SINGLE_THREADED",
        ]
    )
    if mterrain_profile == "web_extended":
        env.Append(CPPDEFINES=["MTERRAIN_PROFILE_WEB_EXTENDED"])
    else:
        env.Append(CPPDEFINES=["MTERRAIN_PROFILE_WEB_CORE"])
else:
    src.extend(Glob("src/hlod/*.cpp"))
    src.extend(Glob("src/grass/*.cpp"))
    src.extend(Glob("src/navmesh/*.cpp"))
    src.extend(Glob("src/octmesh/*.cpp"))
    src.extend(Glob("src/path/*.cpp"))
    if mterrain_profile == "runtime":
        env.Append(CPPDEFINES=["MTERRAIN_PROFILE_RUNTIME"])
    else:
        env.Append(CPPDEFINES=["MTERRAIN_PROFILE_FULL"])
        if env["target"] == "template_debug":
            print("Compiling MTerrain's full debug/editor source profile")
            src.extend(Glob("src/editor/*.cpp"))

libname = "MTerrain{}{}".format(env["suffix"], env["SHLIBSUFFIX"])
libpath = str(output_dir.joinpath(libname))
if env["platform"] == "windows":
    env.Replace(LIBPREFIX="")
variant = "{}-{}-{}-{}-{}-{}".format(
    env["platform"],
    env["target"],
    env["arch"],
    env["precision"],
    "threads" if env["threads"] else "nothreads",
    mterrain_profile,
)
object_root = source_dir.parent.joinpath("build", "scons", variant)
objects = []
for source in src:
    relative_stem = os.path.splitext(str(source))[0]
    object_target = object_root.joinpath(relative_stem)
    objects.extend(env.SharedObject(target=str(object_target), source=source))

# The target-specific static binding library completes before any MTerrain
# object begins reading its generated headers.
env.Requires(objects, env["LIBS"])
sharedlib = env.SharedLibrary(libpath, objects)
Default(sharedlib)
